{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	}
	@static path /img/* /icon.svg /style.css
	header @static Cache-Control "public, max-age=86400"
	file_server
	handle_errors {
		@missing expression {err.status_code} == 404
		rewrite @missing /404.html
		file_server
	}
}
